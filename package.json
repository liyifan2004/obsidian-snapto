{
  "name": "obsidian-snapto",
  "version": "0.1.2",
  "description": "Exact-match auto navigation and keyboard-driven result selection for Obsidian search.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run build",
    "sync": "node scripts/sync-to-vault.mjs",
    "check:runtime": "node scripts/runtime-check.mjs",
    "check:public": "node scripts/check-public.mjs",
    "prepublishOnly": "node scripts/check-public.mjs"
  },
  "keywords": [
    "obsidian",
    "search",
    "quick-switcher",
    "keyboard"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.6.0",
    "jsdom": "^31.0.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.7"
  }
}
