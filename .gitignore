# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js
main.js.map

# Exclude sourcemaps
*.map
*.js.map

# obsidian
data.json
.DS_Store

# editor / agent workspace data
.workbuddy

# test / build caches
coverage
.vitest
*.tsbuildinfo

# Internal advisory / agent working documents. Never publish these.
# The real defence is that they live outside the repository
# (<repo-parent>/_internal/<project>/); these rules only catch a mistake.
docs/TASKS-*.md
docs/REVIEW-*.md
docs/*-INTERNAL.md
internal/
*.local.md

# Machine-specific operations scripts (credentials, local proxy ports).
*.ps1
